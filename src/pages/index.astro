---
import BaseLayout from '../layouts/BaseLayout.astro';
const schema = {"@context":"https://schema.org","@type":"LocalBusiness","name":"Pieterhuizen Planning","description":"Town Planners Cape Town","address":{"@type":"PostalAddress","addressLocality":"Cape Town","addressRegion":"Western Cape","addressCountry":"ZA"},"areaServed":["Cape Town","Somerset West","Stellenbosch"]};
---

<BaseLayout
  title="Town Planners Cape Town — Rezoning, Subdivisions & Land Use"
  description="Professional town planning consultants. Rezoning, subdivisions and land use applications across the Western Cape."
  schema={schema}
>

  <!-- ═══ HERO (F+P: news overlay + full-bleed image) ═══ -->
  <section class="hero">
    <div class="hero-image" style="background: url('/hero-bg.jpg') center/cover no-repeat"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content" style="padding-top:40vh">
      <div class="hero-label anim">recent</div>
      <h1 class="hero-title anim anim-d1">
        Shaping sustainable communities across the Western Cape
      </h1>
      <p class="hero-subtitle anim anim-d2">
        We navigate the complexities of municipal planning — from rezoning to subdivision — so you don't have to.
      </p>
      <div style="margin-top:2rem" class="anim anim-d3">
        <a href="/contact/" class="btn-primary">Contact us</a>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES (F+P: section heading + cards) ═══ -->
  <section style="padding:8rem 0 6rem">
    <div class="wrap">
      <h2 class="section-heading anim">Services</h2>
      <div style="display:grid;grid-template-columns:1fr;gap:0.5px">
        <!-- Split: Rezoning -->
        <div class="split-section anim anim-d1">
          <div class="split-image" style="background: url('/images/img-3129839.jpg') center/cover no-repeat"></div>
          <div class="split-text">
            <h3 style="margin-bottom:1rem">Rezoning</h3>
            <p style="margin-bottom:1.5rem">Change the use rights of a property. We manage the full application process across all Western Cape municipalities.</p>
            <a href="/services/" style="color:var(--color-text);font-size:0.8125rem;text-decoration:none;border-bottom:1px solid var(--color-text);padding-bottom:0.25rem">View services</a>
          </div>
        </div>
      </div>

      <!-- Card grid: Other services -->
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.5px;margin-top:0.5px">
        <a href="/services/" class="img-card anim anim-d2">
          <div class="img-card-image" style="background: url('/images/img-7937283.jpg') center/cover no-repeat"></div>
          <div class="img-card-label">Subdivisions</div>
        </a>
        <a href="/services/" class="img-card anim anim-d2">
          <div class="img-card-image" style="background: url('/images/img-8431134.jpg') center/cover no-repeat"></div>
          <div class="img-card-label">Departures</div>
        </a>
        <a href="/services/" class="img-card anim anim-d2">
          <div class="img-card-image" style="background: url('/images/img-12318703.jpg') center/cover no-repeat"></div>
          <div class="img-card-label">Title deed removal</div>
        </a>
        <a href="/services/" class="img-card anim anim-d3">
          <div class="img-card-image" style="background: url('/images/img-37721311.jpg') center/cover no-repeat"></div>
          <div class="img-card-label">Development reports</div>
        </a>
      </div>
    </div>
  </section>

  <hr class="section-divider">

  <!-- ═══ PROJECTS (F+P: section heading + grid) ═══ -->
  <section style="padding:8rem 0">
    <div class="wrap">
      <h2 class="section-heading anim">Projects</h2>
      <div class="project-grid">
        <a href="/projects/" class="project-card anim anim-d1">
          <div class="project-card-image" style="background: url('/images/img-1131863.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Residential Rezoning</div>
            <div class="project-card-meta">Somerset West, 2026</div>
          </div>
        </a>
        <a href="/projects/" class="project-card anim anim-d1">
          <div class="project-card-image" style="background: url('/images/img-1586148.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Estate Subdivision</div>
            <div class="project-card-meta">Stellenbosch, 2025</div>
          </div>
        </a>
        <a href="/projects/" class="project-card anim anim-d1">
          <div class="project-card-image" style="background: url('/images/img-10702041.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Building Line Departure</div>
            <div class="project-card-meta">Cape Town, 2025</div>
          </div>
        </a>
        <a href="/projects/" class="project-card anim anim-d2">
          <div class="project-card-image" style="background: url('/images/img-2514002.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Mixed-Use Application</div>
            <div class="project-card-meta">Durbanville, 2025</div>
          </div>
        </a>
        <a href="/projects/" class="project-card anim anim-d2">
          <div class="project-card-image" style="background: url('/images/img-19234024.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Estate Consolidation</div>
            <div class="project-card-meta">Paarl, 2024</div>
          </div>
        </a>
        <a href="/projects/" class="project-card anim anim-d2">
          <div class="project-card-image" style="background: url('/images/img-17189038.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Sectional Title Scheme</div>
            <div class="project-card-meta">Somerset West, 2024</div>
          </div>
        </a>
      </div>
      <div style="margin-top:3rem" class="anim anim-d3">
        <a href="/projects/" class="btn-outline">View all projects</a>
      </div>
    </div>
  </section>

  <hr class="section-divider">

  <!-- ═══ ABOUT (F+P: split layout + quote) ═══ -->
  <section style="padding:8rem 0">
    <div class="wrap">
      <h2 class="section-heading anim">About</h2>
    </div>
    <div class="split-section anim anim-d1">
      <div class="split-image" style="background: url('/images/img-29561793.jpg') center/cover no-repeat"></div>
      <div class="split-text">
        <p style="font-size:1.125rem;margin-bottom:1.5rem">
          &ldquo;From the very beginning our practice was founded on a commitment to precision, local knowledge and getting applications approved.&rdquo;
        </p>
        <p style="font-size:0.8125rem;color:var(--color-text-muted)">
          Pieterhuizen Planning
        </p>
        <div style="margin-top:2rem">
          <a href="/about/" class="btn-outline">Learn more</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider">

  <!-- ═══ LOCATIONS (F+P: section heading + grid) ═══ -->
  <section style="padding:8rem 0">
    <div class="wrap">
      <h2 class="section-heading anim">Areas we serve</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.5px">
        <div class="split-text anim anim-d1">
          <h3 style="margin-bottom:0.75rem">Cape Town</h3>
          <p style="font-size:0.875rem">City Bowl &middot; Atlantic Seaboard &middot; Southern Suburbs &middot; Northern Suburbs</p>
        </div>
        <div class="split-text anim anim-d1">
          <h3 style="margin-bottom:0.75rem">Somerset West</h3>
          <p style="font-size:0.875rem">Helderberg &middot; Strand &middot; Gordon's Bay &middot; Sir Lowry's Pass</p>
        </div>
        <div class="split-text anim anim-d1">
          <h3 style="margin-bottom:0.75rem">Stellenbosch</h3>
          <p style="font-size:0.875rem">Heritage planning &middot; Cape Winelands &middot; Franschhoek &middot; Paarl</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider">

  <!-- ═══ CTA (F+P: simple section) ═══ -->
  <section style="padding:8rem 0;text-align:center">
    <div class="narrow anim">
      <h2 class="section-heading" style="text-align:center">Start your project</h2>
      <p style="font-size:1.0625rem;color:var(--color-text-secondary);margin-bottom:2.5rem">
        Free land use assessment. Response within 24 hours.
      </p>
      <a href="/contact/" class="btn-primary">Contact us</a>
    </div>
  </section>

</BaseLayout>
