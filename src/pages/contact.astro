---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Pieterhuizen Planning"
  description="Get in touch for a free land use assessment. Town planning consultants based in Somerset West, Western Cape."
>

  <!-- Hero -->
  <section class="hero" style="min-height:50vh">
    <div class="hero-image" style="background: url('/hero-bg.jpg') center/cover no-repeat"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content" style="padding-bottom:4rem">
      <div class="hero-label">Get in touch</div>
      <h1 class="hero-title">Contact</h1>
      <p class="hero-subtitle">
        Free initial assessment. We typically respond within 24 hours.
      </p>
    </div>
  </section>

  <!-- Contact (F+P style split) -->
  <section style="padding:6rem 0">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr;gap:4rem">
        <!-- Form column -->
        <div>
          <h2 class="section-heading" style="margin-bottom:3rem">New enquiry</h2>
          <form action="https://formsubmit.co/marcus@brandaisolutions.co.za" method="POST" style="max-width:36rem">
            <input type="hidden" name="_subject" value="Pieterhuizen Planning Enquiry">
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_template" value="table">

            <div style="margin-bottom:2rem">
              <label class="form-label" for="name">Name</label>
              <input type="text" id="name" name="name" class="form-input" placeholder="Your name" required>
            </div>
            <div style="margin-bottom:2rem">
              <label class="form-label" for="email">Email</label>
              <input type="email" id="email" name="email" class="form-input" placeholder="Your email" required>
            </div>
            <div style="margin-bottom:2rem">
              <label class="form-label" for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" class="form-input" placeholder="Your phone number">
            </div>
            <div style="margin-bottom:2rem">
              <label class="form-label" for="service">Service</label>
              <select id="service" name="service" class="form-input" style="appearance:none;background:transparent">
                <option value="">Select a service</option>
                <option value="rezoning">Rezoning</option>
                <option value="subdivision">Subdivision</option>
                <option value="departure">Departure</option>
                <option value="title-deed">Title deed removal</option>
                <option value="development-report">Development report</option>
                <option value="consent-use">Consent use</option>
                <option value="other">Other / Not sure</option>
              </select>
            </div>
            <div style="margin-bottom:2.5rem">
              <label class="form-label" for="message">Message</label>
              <textarea id="message" name="message" class="form-textarea" placeholder="Tell us about your property and what you need" required></textarea>
            </div>
            <button type="submit" class="btn-primary">Send enquiry</button>
          </form>
        </div>

        <!-- Info column -->
        <div>
          <h2 class="section-heading" style="margin-bottom:3rem">Office</h2>

          <!-- Somerset West -->
          <div class="split-section" style="min-height:auto;margin-bottom:2rem">
            <div class="split-image" style="min-height:200px;background:url('/images/img-29561793.jpg') center/cover no-repeat"></div>
            <div class="split-text">
              <h3 style="margin-bottom:0.5rem">Somerset West</h3>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.25rem">Helderberg Office Park</p>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.25rem">Somerset West, 7130</p>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.75rem">Western Cape, South Africa</p>
              <a href="tel:+278****4843" style="color:var(--color-text);font-size:0.8125rem;text-decoration:none">083 262 4843</a>
            </div>
          </div>

          <!-- Contact details -->
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.5px;margin-top:3rem">
            <div class="split-text">
              <h3 style="margin-bottom:0.5rem">WhatsApp</h3>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.25rem">Quickest response</p>
              <a href="https://wa.me/27832624843" style="color:var(--color-text);font-size:0.8125rem;text-decoration:none">+27 83 262 4843</a>
            </div>
            <div class="split-text">
              <h3 style="margin-bottom:0.5rem">General</h3>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.25rem">Information</p>
              <a href="mailto:wilhelm@pieterhuizen.co.za" style="color:var(--color-text);font-size:0.8125rem;text-decoration:none">wilhelm@pieterhuizen.co.za</a>
            </div>
            <div class="split-text">
              <h3 style="margin-bottom:0.5rem">New business</h3>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.25rem">Project enquiries</p>
              <a href="mailto:wilhelm@pieterhuizen.co.za" style="color:var(--color-text);font-size:0.8125rem;text-decoration:none">wilhelm@pieterhuizen.co.za</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
