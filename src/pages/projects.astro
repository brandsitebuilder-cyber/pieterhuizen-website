---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects — Town Planning Case Studies"
  description="Recent town planning projects. Rezoning, subdivisions, departures and land use applications across the Western Cape."
>

  <!-- Hero -->
  <section class="hero" style="min-height:50vh">
    <div class="hero-image" style="background: url('/hero-bg.jpg') center/cover no-repeat"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content" style="padding-bottom:4rem">
      <div class="hero-label">Portfolio</div>
      <h1 class="hero-title">Projects</h1>
      <p class="hero-subtitle">
        A selection of recent town planning applications across the Western Cape.
      </p>
    </div>
  </section>

  <!-- Project grid (F+P style) -->
  <section style="padding:6rem 0">
    <div class="wrap">
      <div class="project-grid">
        <a href="#" class="project-card">
          <div class="project-card-image" style="background: url('/images/img-1131863.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Residential Rezoning</div>
            <div class="project-card-meta">Somerset West &middot; 2026</div>
          </div>
        </a>
        <a href="#" class="project-card">
          <div class="project-card-image" style="background: url('/images/img-1586148.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Estate Subdivision</div>
            <div class="project-card-meta">Stellenbosch &middot; 2025</div>
          </div>
        </a>
        <a href="#" class="project-card">
          <div class="project-card-image" style="background: url('/images/img-10702041.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Building Line Departure</div>
            <div class="project-card-meta">Cape Town &middot; 2025</div>
          </div>
        </a>
        <a href="#" class="project-card">
          <div class="project-card-image" style="background: url('/images/img-2514002.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Mixed-Use Application</div>
            <div class="project-card-meta">Durbanville &middot; 2025</div>
          </div>
        </a>
        <a href="#" class="project-card">
          <div class="project-card-image" style="background: url('/images/img-19234024.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Estate Consolidation</div>
            <div class="project-card-meta">Paarl &middot; 2024</div>
          </div>
        </a>
        <a href="#" class="project-card">
          <div class="project-card-image" style="background: url('/images/img-17189038.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Sectional Title Scheme</div>
            <div class="project-card-meta">Somerset West &middot; 2024</div>
          </div>
        </a>
        <a href="#" class="project-card">
          <div class="project-card-image" style="background: url('/images/img-12318703.jpg') center/cover no-repeat"></div>
          <div class="project-card-info">
            <div class="project-card-name">Title Deed Removal</div>
            <div class="project-card-meta">Strand &middot; 2024</div>
          </div>
        </a>
        <a href="#" class="project-card">
