---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Pieterhuizen Planning"
  description="Town planning consultants based in Somerset West. Serving Cape Town, Stellenbosch and the Western Cape with rezoning, subdivisions and land use applications."
>

  <!-- Hero -->
  <section class="hero" style="min-height:50vh">
    <div class="hero-image" style="background: url('/hero-bg.jpg') center/cover no-repeat"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content" style="padding-bottom:4rem">
      <div class="hero-label">Studio</div>
      <h1 class="hero-title">About</h1>
      <p class="hero-subtitle">
        Town planning consultants committed to precision, local knowledge, and getting applications approved.
      </p>
    </div>
  </section>

  <!-- Split: Who we are (F+P style) -->
  <section style="padding:6rem 0">
    <div class="split-section">
      <div class="split-image" style="background: url('/images/img-29561793.jpg') center/cover no-repeat"></div>
      <div class="split-text">
        <p style="font-size:1.125rem;margin-bottom:2rem">
          &ldquo;We are a town planning consultancy for sustainable development and land use, founded on a commitment to getting it right.&rdquo;
        </p>
        <p style="font-size:0.8125rem;color:var(--color-text-muted)">Pieterhuizen Planning</p>
        <div style="margin-top:2rem;display:flex;gap:1rem">
          <a href="/contact/" class="btn-primary">Contact us</a>
          <a href="/services/" class="btn-outline">View services</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider">

  <!-- Approach -->
  <section style="padding:6rem 0">
    <div class="wrap">
      <h2 class="section-heading">Approach</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.5px">
        <div class="split-text">
          <h3 style="margin-bottom:1rem">Local knowledge</h3>
          <p style="font-size:0.9375rem">Deep understanding of Western Cape municipalities &mdash; their zoning schemes, SDFs, and political dynamics. This is what gets applications approved.</p>
        </div>
        <div class="split-text">
          <h3 style="margin-bottom:1rem">Regulatory precision</h3>
          <p style="font-size:0.9375rem">SPLUMA-compliant applications prepared with meticulous attention to detail. Every motivation report is built to withstand council scrutiny.</p>
        </div>
        <div class="split-text">
          <h3 style="margin-bottom:1rem">Full spectrum</h3>
          <p style="font-size:0.9375rem">From initial feasibility to council approval. We coordinate architects, engineers, environmental specialists and legal teams so you don't have to.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider">

  <!-- Experience -->
  <section style="padding:6rem 0">
    <div class="wrap">
      <h2 class="section-heading">Experience</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:2rem">
        <div>
          <div style="font-size:2.5rem;font-weight:200;margin-bottom:0.5rem">50+</div>
          <div style="color:var(--color-text-muted);font-size:0.8125rem">Projects approved</div>
        </div>
        <div>
          <div style="font-size:2.5rem;font-weight:200;margin-bottom:0.5rem">10+</div>
          <div style="color:var(--color-text-muted);font-size:0.8125rem">Years experience</div>
        </div>
        <div>
          <div style="font-size:2.5rem;font-weight:200;margin-bottom:0.5rem">3</div>
          <div style="color:var(--color-text-muted);font-size:0.8125rem">Core regions</div>
        </div>
        <div>
          <div style="font-size:2.5rem;font-weight:200;margin-bottom:0.5rem">100%</div>
          <div style="color:var(--color-text-muted);font-size:0.8125rem">Compliance rate</div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
