---
import '../styles/global.css';
interface Props { title: string; description: string; schema?: object; }
const { title, description, schema } = Astro.props;
const currentPath = Astro.url.pathname;
---

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Menu toggle
    const menuBtn = document.querySelector('.nav-menu');
    const overlay = document.getElementById('menu-overlay');
    const closeBtn = document.querySelector('.menu-close');
    menuBtn?.addEventListener('click', () => overlay?.classList.add('open'));
    closeBtn?.addEventListener('click', () => overlay?.classList.remove('open'));
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) overlay.classList.remove('open');
    });

    // Nav scroll
    const nav = document.querySelector('.nav');
    window.addEventListener('scroll', () => {
      nav?.classList.toggle('scrolled', window.scrollY > 50);
    });
  });
</script>

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>{title} | Pieterhuizen Planning</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Pieterhuizen Planning">
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>

<nav class="nav scrolled">
  <div class="nav-inner">
    <a href="/" class="nav-logo">Pieterhuizen Planning</a>
    <div class="nav-links">
      <a href="/services/" class="nav-link {currentPath.startsWith('/services') ? 'active' : ''}">services</a>
      <a href="/projects/" class="nav-link {currentPath.startsWith('/projects') ? 'active' : ''}">projects</a>
      <a href="/about/" class="nav-link {currentPath === '/about/' ? 'active' : ''}">about</a>
      <a href="/contact/" class="nav-link {currentPath === '/contact/' ? 'active' : ''}">contact</a>
    </div>
    <div class="nav-actions">
      <span class="nav-search">search</span>
      <button class="nav-menu">menu</button>
    </div>
  </div>
</nav>

<!-- Full-screen menu overlay -->
<div id="menu-overlay">
  <button class="menu-close">close</button>
  <a href="/services/" class="menu-item">services</a>
  <a href="/projects/" class="menu-item">projects</a>
  <a href="/about/" class="menu-item">about</a>
  <a href="/contact/" class="menu-item">contact</a>
</div>

<main><slot /></main>

<!-- Floating WhatsApp button -->
<a href="https://wa.me/27832624843" class="whatsapp-float" aria-label="Chat on WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="48" height="48" fill="white"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm-2.58 3.76c-.17-.01-.37.02-.55.1-.27.13-.82.39-1.12 1.13-.32.78-.07 1.63.27 2.21.35.62 1.4 2.33 3.22 3.54 1.64 1.09 2.27 1.08 3.03.82.34-.12 1.12-.55 1.39-1.18.27-.63.27-1.08.19-1.18-.08-.1-.22-.17-.49-.29-.26-.12-1.46-.72-1.69-.8-.22-.08-.38-.12-.54.12-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.77-1.84-.2-.48-.4-.42-.56-.42z"/></svg>
</a>

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <p style="color:var(--color-text);font-size:1.0625rem;font-weight:400;margin-bottom:0.75rem">Pieterhuizen Planning</p>
        <p style="color:var(--color-text-muted);font-size:0.8125rem;max-width:20rem">Town planning consultants serving the Western Cape. Rezoning, subdivisions, departures and land use applications.</p>
      </div>
      <div>
        <h4>Services</h4>
        <div style="display:flex;flex-direction:column;gap:0.75rem">
          <a href="/services/#rezoning">Rezoning</a>
          <a href="/services/#subdivisions">Subdivisions</a>
          <a href="/services/#departures">Departures</a>
          <a href="/services/#development">Development reports</a>
          <a href="/services/">All services</a>
        </div>
      </div>
      <div>
        <h4>Company</h4>
        <div style="display:flex;flex-direction:column;gap:0.75rem">
          <a href="/about/">About</a>
          <a href="/projects/">Projects</a>
          <a href="/contact/">Contact</a>
          <a href="https://wa.me/27832624843">WhatsApp</a>
          <a href="tel:+27832624843">083 262 4843</a>
          <a href="mailto:wilhelm@pieterhuizen.co.za">wilhelm@pieterhuizen.co.za</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-social">
        <a href="#" aria-label="Instagram">Instagram</a>
        <a href="#" aria-label="LinkedIn">LinkedIn</a>
        <a href="#" aria-label="Facebook">Facebook</a>
      </div>
      <div style="display:flex;gap:1.5rem;font-size:0.75rem;color:var(--color-text-muted)">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <span>&copy; {new Date().getFullYear()} Pieterhuizen Planning</span>
      </div>
    </div>
  </div>
</footer>

</body>
</html>
